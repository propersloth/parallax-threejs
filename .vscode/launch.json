{
  "version": "0.2.0",
  "configurations": [
    {
      // Attaches to the SAME persistent Chromium tab live-scene.ts's
      // attachToLiveScene() owns — not a fresh browser VS Code launches
      // itself. That's deliberate, matching the whole "shared sight"
      // premise this plugin is built around (see live-scene.ts's own
      // header comment): set a breakpoint here, interact with the live
      // page, and it hits in the exact session Claude/checkpoint/sweep
      // are also driving.
      //
      // Requires that tab to already exist — run any interactive command
      // (/checkpoint, /sweep, ...) at least once first; attachToLiveScene()
      // launches it on demand at BRIDGE_PORT (default 9223 — deliberately
      // not 9222, which is threejs-devtools-mcp's own unrelated bridge
      // default; change the port below to match if you've overridden it).
      "type": "chrome",
      "request": "attach",
      "name": "Attach to live Chromium (BRIDGE_PORT)",
      "port": 9223,
      "webRoot": "${workspaceFolder}"
    },
    {
      // Generic: debug whatever Deno file is currently open (checkpoint.ts,
      // sweep-param.ts, setup.ts, etc.) with real breakpoints. Standard
      // Deno-via-node-debug-adapter pattern.
      "request": "launch",
      "name": "Debug: current Deno file",
      "type": "node",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "deno",
      "runtimeArgs": ["run", "--inspect-wait", "--allow-all", "${file}"],
      "attachSimplePort": 9229
    },
    {
      // Same idea, scoped to Lane 1's test suite — breakpoints inside
      // check-shader-bindings.ts, manifest.ts, diff.ts, etc. hit as the
      // tests run.
      "request": "launch",
      "name": "Debug: Lane 1 tests",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "test",
        "--inspect-wait",
        "--allow-run=git",
        "--allow-read",
        "--allow-write",
        "--ignore=scaffold/test/visual/lib/capture_test.ts,scaffold/scripts/lib/live-scene_test.ts",
        "scripts/",
        "hooks/",
        "scaffold/"
      ],
      "attachSimplePort": 9229
    },
    {
      // Lane 2 — breakpoints inside capture.ts/live-scene.ts's own logic
      // (the test code), not inside the fixture page it drives. For
      // stepping through page-side JS instead, use the Chromium-attach
      // config above against a real running session.
      "request": "launch",
      "name": "Debug: Lane 2 tests (browser-based)",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "test",
        "--inspect-wait",
        "--allow-net",
        "--allow-read",
        "--allow-write",
        "--allow-env",
        "--allow-run",
        "scaffold/test/visual/lib/capture_test.ts",
        "scaffold/scripts/lib/live-scene_test.ts"
      ],
      "attachSimplePort": 9229
    }
  ]
}
